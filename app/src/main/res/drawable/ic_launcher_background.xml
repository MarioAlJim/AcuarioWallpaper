<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background: the same vertical "underwater" gradient used by
    acuario_background.frag (deep teal at the bottom, lighter teal near the top), plus a
    handful of small bubble rings for a little texture/depth.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="108"
                android:endX="54"
                android:endY="0"
                android:type="linear">
                <item android:color="#FF071E22" android:offset="0.0" />
                <item android:color="#FF1E8F79" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Small bubble rings, kept near the edges so the safe-zone content isn't crowded -->
    <path
        android:pathData="M20,22 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:fillColor="#00000000"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M90,80 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#00000000"
        android:strokeColor="#2EFFFFFF"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M14,88 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0"
        android:fillColor="#00000000"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="1.4" />
    <path
        android:pathData="M92,18 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#00000000"
        android:strokeColor="#2EFFFFFF"
        android:strokeWidth="1.4" />
</vector>
