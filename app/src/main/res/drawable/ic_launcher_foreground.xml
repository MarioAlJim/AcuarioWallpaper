<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: a simple top-down turtle silhouette (shell + head + tail + 4
    legs), matching the wallpaper's mascot. Kept within the ~66dp safe zone centered in the
    108dp viewport so it survives every launcher mask shape (circle, squircle, rounded square).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Legs (drawn first, so the shell overlaps their inner edge) -->
    <path
        android:fillColor="#FFF4F1E8"
        android:pathData="M30,42 m-8,-11 a8,11 0 1,0 16,0 a8,11 0 1,0 -16,0" />
    <path
        android:fillColor="#FFF4F1E8"
        android:pathData="M78,42 m-8,-11 a8,11 0 1,0 16,0 a8,11 0 1,0 -16,0" />
    <path
        android:fillColor="#FFF4F1E8"
        android:pathData="M30,76 m-8,-10 a8,10 0 1,0 16,0 a8,10 0 1,0 -16,0" />
    <path
        android:fillColor="#FFF4F1E8"
        android:pathData="M78,76 m-8,-10 a8,10 0 1,0 16,0 a8,10 0 1,0 -16,0" />

    <!-- Tail -->
    <path
        android:fillColor="#FFF4F1E8"
        android:pathData="M54,85 m-5,-6 a5,6 0 1,0 10,0 a5,6 0 1,0 -10,0" />

    <!-- Head -->
    <path
        android:fillColor="#FFF4F1E8"
        android:pathData="M54,29 m-9,-9 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />

    <!-- Shell -->
    <path
        android:fillColor="#FFF4F1E8"
        android:pathData="M54,58 m-22,-18 a22,18 0 1,0 44,0 a22,18 0 1,0 -44,0" />

    <!-- Loose shell-pattern hint -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#331E4A3E"
        android:strokeWidth="1.6"
        android:pathData="M54,58 m-13,-11 a13,11 0 1,0 26,0 a13,11 0 1,0 -26,0" />

    <!-- Eye -->
    <path
        android:fillColor="#FF14201E"
        android:pathData="M58,27 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" />
</vector>
